# Exemple de structure pour .streamlit/secrets.toml — NE PAS COMMITER LE VRAI FICHIER.
#
# En local : copie ce fichier en .streamlit/secrets.toml et renseigne ta clé
# (ou utilise simplement .env à la racine, déjà supporté via python-dotenv —
# les deux fonctionnent, secrets.toml n'est utile en local que si tu préfères
# rester dans l'écosystème Streamlit plutôt que .env).
#
# Sur Streamlit Community Cloud : ne dépose jamais ce fichier tel quel dans le
# repo. Configure plutôt le vrai secret dans l'interface de l'app déployée
# (Settings -> Secrets), en collant le même contenu (sans le .example).
# Streamlit expose automatiquement chaque clé de premier niveau à la fois via
# st.secrets["GROQ_API_KEY"] ET via os.environ["GROQ_API_KEY"] — c'est ce
# second mécanisme qu'utilise ce projet (os.environ.get(...) dans
# src/rag/agent.py et src/rag/tools/risk_summarizer.py), donc aucun code
# spécifique à Streamlit n'est nécessaire pour lire le secret.

GROQ_API_KEY = "your_groq_api_key_here"

# Optionnel : seulement si le dossier ChromaDB persistant doit être ailleurs
# que le chemin par défaut ("./data/processed/chroma", relatif à la racine
# du repo déployé).
# CHROMA_PERSIST_DIR = "./data/processed/chroma"
